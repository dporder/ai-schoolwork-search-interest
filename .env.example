# Copy this file to `.env` and fill in your credentials.
# `.env` is gitignored and must NOT be committed.

# U.S. Census Bureau API key
# Sign up: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Kaggle API credentials (for the DMA-FIPS crosswalk dataset)
# Sign in to Kaggle, go to Account -> "Create New API Token", then copy
# the values from the downloaded kaggle.json into the variables below.
KAGGLE_USERNAME=
KAGGLE_KEY=
